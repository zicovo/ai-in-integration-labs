# The lab stack's provider configuration. Copy this to `.env` beside it and fill it in:
#
#     cp labs/stack/.env.example labs/stack/.env
#
# `.env` is git-ignored and must stay that way. A key in a repository is a bad habit in any
# project and a worse one in a course about governing agent traffic.
#
# Leave every line empty or delete the file and the stack runs on a local model instead
# (dec:OD-025 kept that path as the fallback). It is slower and free, and every lab still works.
# Nothing here is named in a handout.

# The endpoint your instructor gave you, copied as given. Usually an Azure API Management
# gateway, where your key is a subscription key of your own.
#   example: https://my-gateway.azure-api.net/academy
#   also works: a classic Azure OpenAI resource, https://my-resource.openai.azure.com, or an
#   Azure AI Foundry endpoint, https://my-resource.services.ai.azure.com/openai/v1
AZURE_API_BASE=

# Your key. One per participant, issued before the session (dec:OD-025).
AZURE_API_KEY=

# The API version your resource serves.
AZURE_API_VERSION=2024-10-21

# The deployment name for the chat model, as it appears in your Azure resource. This is a
# deployment name and not a model name, and the two are often different.
AQUAFLUX_AZURE_DEPLOYMENT=

# The deployment name for the embedding model. Only b-01 and b-02 need it, so it can stay empty
# until those labs are built.
AQUAFLUX_AZURE_EMBED_DEPLOYMENT=
